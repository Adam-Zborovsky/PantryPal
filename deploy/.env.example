# Copy to deploy/.env. This file must remain local and untracked.
# The Flutter value is compiled into the web build and must be PantryPal's public
# HTTPS host plus the trailing /v1 path.
API_BASE_URL=https://<public-host>/v1

# Public origins and hosts
APP_ORIGIN=https://<public-host>
API_ORIGIN=https://<public-host>/v1

# Database configuration
# The database hostname is the Compose service name (pantrypal-db).
POSTGRES_USER=pantrypal
POSTGRES_PASSWORD=<strong-database-password>
POSTGRES_DB=pantrypal
DATABASE_URL=postgresql://pantrypal:<strong-database-password>@pantrypal-db:5432/pantrypal?schema=public

# Object storage (MinIO) credentials
S3_ACCESS_KEY=<strong-s3-access-key>
S3_SECRET_KEY=<strong-s3-secret-key>
S3_BUCKET=pantrypal
MINIO_ROOT_USER=<strong-s3-access-key>
MINIO_ROOT_PASSWORD=<strong-s3-secret-key>

# Authentication token secrets (generate distinct high-entropy random strings)
# NOTE: If any password or secret contains a literal '$', escape it as '$$'
# to prevent Docker Compose from attempting variable expansion (e.g. secret$DnA -> secret$$DnA).
ACCESS_TOKEN_SECRET=<random-64-character-hex>
REFRESH_TOKEN_SECRET=<random-64-character-hex>

# Provider keys (optional / as needed)
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.6-flash
YOUTUBE_API_KEY=
YOUTUBE_MEDIA_DOWNLOAD_ENABLED=false
SOCIAL_MEDIA_DOWNLOAD_ENABLED=false

# Push notifications (optional)
FIREBASE_MESSAGING_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=
