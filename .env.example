# PantryPal application
APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
PORT=3001

# Local services supplied by the operator
DATABASE_URL=postgresql://pantrypal:pantrypal@localhost:5432/pantrypal?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pantrypal
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Generate strong distinct values for non-development environments
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Recipe analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
YOUTUBE_API_KEY=
SOCIAL_MEDIA_DOWNLOAD_ENABLED=false
YT_DLP_PATH=.media-tools-venv/Scripts/yt-dlp.exe
GALLERY_DL_PATH=.media-tools-venv/Scripts/gallery-dl.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TEMP_ROOT=
MEDIA_MAX_BYTES=524288000
MEDIA_MAX_DURATION_SECONDS=1800

# Optional Android and browser push
FCM_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:operator@example.com
