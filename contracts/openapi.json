  "info": {
    "title": "PantryPal API",
    "description": "Invite-only household recipe planning API.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "example": "correct-horse-battery-staple"
          },
          "displayName": {
            "type": "string",
            "example": "Alex"
          },
          "betaInvite": {
            "type": "string",
            "description": "One-time operator beta invite."
          },
          "householdName": {
            "type": "string",
            "example": "The Martins"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Jerusalem",
            "default": "UTC"
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "android"
            ],
            "default": "web"
          }
        },
        "required": [
          "email",
          "password",
          "displayName",
          "betaInvite",
          "householdName"
        ]
      },
      "AccountResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName"
        ]
      },
      "HouseholdResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "timezone"
        ]
      },
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string",
            "description": "Returned only to Android clients."
          },
          "account": {
            "$ref": "#/components/schemas/AccountResponseDto"
          },
          "household": {
            "$ref": "#/components/schemas/HouseholdResponseDto"
          },
          "householdCode": {
            "type": "string",
            "description": "Returned only immediately after registration."
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "android"
            ],
            "default": "web"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Android-only refresh credential."
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "android"
            ],
            "default": "web"
          }
        }
      },
      "JoinHouseholdDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Shareable household code."
          }
        },
        "required": [
          "code"
        ]
      },
      "CreateMediaUploadDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "image"
            ]
          },
          "mimeType": {
            "type": "string",
            "example": "image/jpeg"
          },
          "byteSize": {
            "type": "number",
            "description": "Exact client-side byte count.",
            "example": 524288
          }
        },
        "required": [
          "kind",
          "mimeType",
          "byteSize"
        ]
      },
      "MediaUploadResponseDto": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string"
          },
          "uploadUrl": {
            "type": "string",
            "description": "Short-lived signed PUT URL. Treat as a secret."
          },
          "uploadExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "assetExpiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "assetId",
          "uploadUrl",
          "uploadExpiresAt",
          "assetExpiresAt"
        ]
      },
      "CompleteMediaUploadResponseDto": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "READY"
            ]
          },
          "byteSize": {
            "type": "number"
          }
        },
        "required": [
          "assetId",
          "status",
          "byteSize"
        ]
      },
      "CreateImportDto": {
        "type": "object",
        "properties": {
          "sourceKind": {
            "type": "string",
            "enum": [
              "url",
              "text",
              "image"
            ]
          },
          "sourceInput": {
            "type": "string"
          }
        },
        "required": [
          "sourceKind",
          "sourceInput"
        ]
      },
      "ReviewIngredientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantityMin": {
            "type": "object"
          },
          "quantityMax": {
            "type": "object"
          },
          "originalUnit": {
            "type": "object"
          },
          "preparationNote": {
            "type": "object"
          },
          "classification": {
            "type": "string",
            "enum": [
              "REQUIRED",
              "FLEXIBLE",
              "PANTRY_STAPLE",
              "GARNISH"
            ]
          },
          "includeInShopping": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "classification",
          "includeInShopping"
        ]
      },
      "SaveRecipeReviewDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "originalServings": {
            "type": "object"
          },
          "yieldWording": {
            "type": "object"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewIngredientDto"
            }
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedRevision": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "ingredients",
          "instructions",
          "expectedRevision"
        ]
      },
      "CreateCookingInstanceDto": {
        "type": "object",
        "properties": {
          "recipeId": {
            "type": "string"
          },
          "targetServings": {
            "type": "string",
            "description": "Desired serving count, encoded as a positive decimal."
          },
          "cookingDate": {
            "type": "string",
            "description": "ISO 8601 cooking date and time. Omit for Quick Cook."
          },
          "shoppingTripId": {
            "type": "string"
          },
          "assignmentMode": {
            "type": "string",
            "enum": [
              "AUTOMATIC",
              "MANUAL"
            ],
            "default": "AUTOMATIC"
          }
        },
        "required": [
          "recipeId",
          "targetServings"
        ]
      },
      "UpdateCookingTripDto": {
        "type": "object",
        "properties": {
          "shoppingTripId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "shoppingTripId"
        ]
      },
      "RequestCookTransferDto": {
        "type": "object",
        "properties": {
          "targetAccountId": {
            "type": "string"
          }
        },
        "required": [
          "targetAccountId"
        ]
      },
      "ResolveCookTransferDto": {
        "type": "object",
        "properties": {
          "accept": {
            "type": "boolean",
            "description": "True accepts responsibility; false declines it."
          }
        },
        "required": [
          "accept"
        ]
      },
      "CookAgainDto": {
        "type": "object",
        "properties": {
          "cookingDate": {
            "type": "string",
            "description": "ISO 8601 cooking date and time for the new instance."
          },
          "targetServings": {
            "type": "string",
            "description": "Target serving count. Defaults to the archived instance."
          }
        }
      },
      "CreateShoppingTripDto": {
        "type": "object",
        "properties": {
          "scheduledFor": {
            "type": "string",
            "description": "ISO 8601 planned shopping date and time."
          }
        }
      },
      "UpdateShoppingTripDto": {
        "type": "object",
        "properties": {
          "scheduledFor": {
            "type": "string",
            "description": "ISO 8601 replacement shopping date and time."
          }
        },
        "required": [
          "scheduledFor"
        ]
      },
      "UpdateShoppingItemDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "NEED_TO_BUY",
              "CONFIRMED_AT_HOME",
              "CHECK_AGAIN",
              "PARTIALLY_AVAILABLE",
              "PURCHASED",
              "IGNORED"
            ]
          },
          "knownQuantity": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateCoverUploadDto": {
        "type": "object",
        "properties": {
          "mimeType": {
            "type": "string",
            "example": "image/jpeg"
          },
          "byteSize": {
            "type": "number",
            "description": "Exact client-side byte count.",
            "example": 524288
          }
        },
        "required": [
          "mimeType",
          "byteSize"
        ]
      },
      "CompleteCoverUploadDto": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string"
          }
        },
        "required": [
          "assetId"
        ]
      },
      "UpsertPushSubscriptionDto": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "android"
            ]
          },
          "endpoint": {
            "type": "string",
            "description": "Firebase Cloud Messaging registration token for this device."
          }
        },
        "required": [
          "platform",
          "endpoint"
        ]
      },
      "RemovePushSubscriptionDto": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "description": "Firebase Cloud Messaging registration token for this device."
          }
        },
        "required": [
          "endpoint"
        ]
      }
    }
  }
}
