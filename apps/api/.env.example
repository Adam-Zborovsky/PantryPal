# PantryPal environment reference. Copy this to a local, untracked `.env` file.
# Never commit credentials, generated service-account keys, or production URLs.

# Runtime mode: `development` locally; set `production` for deployed API/worker processes.
APP_ENV=development
# Browser origin allowed to call the API, including the scheme and port.
APP_ORIGIN=http://localhost:3000
# Public base URL of this API, including the scheme and port.
API_ORIGIN=http://localhost:3001
# TCP port on which the API listens.
PORT=3001

# PostgreSQL connection string. The shown value targets the supplied local Docker database.
DATABASE_URL=postgresql://pantrypal:pantrypal@localhost:5432/pantrypal?schema=public
# Redis connection string for background jobs and realtime fan-out.
REDIS_URL=redis://localhost:6379
# S3-compatible object-storage endpoint; local development uses MinIO.
S3_ENDPOINT=http://localhost:9000
# S3 region required by the SDK; MinIO accepts `us-east-1`.
S3_REGION=us-east-1
# Bucket that stores temporary recipe-import media.
S3_BUCKET=pantrypal
# Object-storage access key. Set this from your secret store for deployed environments.
S3_ACCESS_KEY=
# Object-storage secret key. Set this from your secret store; never commit it.
S3_SECRET_KEY=
# Use path-style S3 URLs for MinIO. Set `false` only for a provider that requires virtual-hosted URLs.
S3_FORCE_PATH_STYLE=true

# Secret used to sign short-lived API access tokens. Generate a distinct high-entropy value per environment.
ACCESS_TOKEN_SECRET=
# Secret used to sign refresh tokens. Generate a different high-entropy value per environment.
REFRESH_TOKEN_SECRET=

# Google Gemini API key for structured recipe extraction. Leave blank to use the deterministic fallback.
GEMINI_API_KEY=
# Gemini model identifier. Keep the default unless the configured provider is intentionally changed.
GEMINI_MODEL=gemini-3.6-flash
# Optional YouTube Data API key for richer public-video metadata.
YOUTUBE_API_KEY=
# Enables backend-only retrieval of public YouTube links for temporary audio/video analysis.
# Enable only where the source terms and the user's rights to process the media permit it.
YOUTUBE_MEDIA_DOWNLOAD_ENABLED=false
# Enables best-effort backend-only processing of public Instagram Reels and TikTok video links.
# Users must have rights to process the linked media. Never configure social-account cookies for PantryPal.
SOCIAL_MEDIA_DOWNLOAD_ENABLED=false
# Path to yt-dlp, used for enabled YouTube and social-video acquisition.
# This is resolved from `apps/api` when running the documented API/worker commands.
# Install the exact pin in `media-tools-requirements.txt` into the root `.media-tools-venv` first.
YT_DLP_PATH=../../.media-tools-venv/Scripts/yt-dlp.exe
# Path or command name for FFmpeg, used to extract and convert imported media audio.
FFMPEG_PATH=ffmpeg
# Path or command name for FFprobe, used to validate imported media streams and duration.
FFPROBE_PATH=ffprobe
# Optional directory for ephemeral media-processing files. Leave blank to use the system temporary directory.
MEDIA_TEMP_ROOT=
# Largest temporary backend video download or extracted-audio file, in bytes (524288000 = 500 MiB).
MEDIA_MAX_BYTES=524288000
# Longest backend-acquired video accepted by the worker, in seconds (1800 = 30 minutes).
MEDIA_MAX_DURATION_SECONDS=1800
# Largest image accepted for Gemini analysis, in bytes (10485760 = 10 MiB).
MEDIA_IMAGE_ANALYSIS_MAX_BYTES=10485760

# Enables server-side Android Firebase Cloud Messaging delivery. Keep `false` until the credential below is mounted.
FIREBASE_MESSAGING_ENABLED=false
# Absolute path on the API host to a Firebase service-account JSON key.
# Firebase Console: Project settings -> Service accounts -> Generate new private key.
# Store/mount that key through deployment secret storage outside this repository, then set this path and enable FCM above.
GOOGLE_APPLICATION_CREDENTIALS=

# Public VAPID key for a future browser-push implementation; not currently used by PantryPal.
VAPID_PUBLIC_KEY=
# Private VAPID key for a future browser-push implementation; keep it in secret storage and never commit it.
VAPID_PRIVATE_KEY=
# Contact URI required by the Web Push protocol for a future browser-push implementation.
WEB_PUSH_SUBJECT=mailto:operator@example.com
